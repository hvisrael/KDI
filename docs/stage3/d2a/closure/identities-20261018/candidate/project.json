      "authorized": true
    },
    {
      "command": "npm ci --ignore-scripts",
      "effects": "En Web, instala paquetes desde lock a node_modules; fuentes oficiales y cache local.",
      "authorized": true
    },
    {
      "command": "python tools/content-manifest.py --verify",
