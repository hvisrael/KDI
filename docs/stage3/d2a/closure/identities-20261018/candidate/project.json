      "authorized": true
    },
    {
      "command": "python tools/smoke-api.py",
      "effects": "Arranca API local temporal, comprueba HTTP y genera evidencia/OpenAPI; sin DB.",
      "authorized": true
    },
    {
      "command": "dotnet run --project tools/Kulani.KDI.StructureCheck --configuration Release --no-restore",
      "effects": "Analiza arquitectura semantica con Roslyn del SDK; genera evidencia del autor.",
      "authorized": true
    },
    {
      "command": "dotnet test Kulani.KDI.slnx --configuration Release --no-restore",
