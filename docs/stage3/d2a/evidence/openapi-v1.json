{
  "openapi": "3.1.1",
  "info": {
    "title": "KDI Foundation API",
    "description": "D1: public liveness and product metadata. No business endpoints.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Foundation"
        ],
        "summary": "Process liveness only; does not check database readiness.",
        "operationId": "GetLiveness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "Foundation"
        ],
        "summary": "Public product metadata without environment or user details.",
        "operationId": "GetSystemInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Foundation"
        ],
        "summary": "Checks the configured SQL target and least-privilege runtime identity; never migrates.",
        "operationId": "GetReadiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LivenessResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ReadinessResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "SystemInfoResponse": {
        "required": [
          "product",
          "apiVersion"
        ],
        "type": "object",
        "properties": {
          "product": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Foundation"
    }
  ]
}
